# Copy to .env and fill in. Never commit .env.

# Deployer / worker signer on Creditcoin CC3 testnet (also used as the Sepolia seed wallet).
PRIVATE_KEY=0x
DEPLOYER_ADDRESS=0x

# Creditcoin CC3 Testnet
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROVER_URL=https://prover.cc3-testnet.creditcoin.network
CC3_EXPLORER_URL=https://explorer.cc3-testnet.creditcoin.network

# Ethereum Sepolia (any archive-capable public RPC that supports eth_getLogs)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Attestcoin source chain key for Sepolia on CC3 (NOT the EVM chainId 11155111)
SEPOLIA_CHAIN_KEY=1

# EvmV1Decoder library. The address in the official examples (0x04B9…) is a stub on CC3 testnet;
# deploy your own with `forge create` (see README) and paste it here.
EVM_V1_DECODER_LIBRARY_ADDRESS=

# Filled by script/Deploy.s.sol into deployments/cc3-testnet.json; optional overrides
CREDIT_BUREAU_ASC_ADDRESS=
CREDIT_LEDGER_ADDRESS=
SCORE_ENGINE_ADDRESS=
CREDIT_PASSPORT_ADDRESS=
TEST_USD_ADDRESS=
TIERED_LENDER_ADDRESS=

# Worker HTTP server
WORKER_PORT=8787
WEB_ORIGIN=http://localhost:3000
